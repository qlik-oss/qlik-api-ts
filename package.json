  "publishConfig": {
    "access": "public",
    "directory": "npm",
    "linkDirectory": false,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown && node ./tools/publish-layout.js",
    "start": "http-server . --port 8000 --cors --tls --cert=\"$HOME/.certs/cert.pem\" --key=\"$HOME/.certs/key.pem\" -c-1",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "lint": "oxlint --deny-warnings",
    "validate": "pnpm format:check && pnpm lint && pnpm check-types && pnpm test"
  },
